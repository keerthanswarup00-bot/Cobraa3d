# Supabase transaction pooler (port 6543) - used at runtime
DATABASE_URI=postgresql://user:pass@host:6543/postgres
# Supabase session pooler (port 5432) - used for migrations
DATABASE_URI_MIGRATE=postgresql://user:pass@host:5432/postgres

# Long random secret
PAYLOAD_SECRET=replace-with-long-random-secret

# Full public origin, no trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional alias for the same public origin
NEXT_PUBLIC_SERVER_URL=https://example.com

# Required to use Payload's draft preview links
PREVIEW_SECRET=replace-with-a-separate-long-random-secret

# Only needed when running `pnpm admin:create`; never commit real values
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Supabase Storage S3
S3_BUCKET=media
# Private bucket for enquiry attachments. Enable signed downloads and block public access.
S3_PRIVATE_BUCKET=enquiry-files
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# Optional cron auth
CRON_SECRET=replace-with-cron-secret

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-the-same-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
VAPID_SUBJECT=mailto:you@example.com

# Optional product publishing automation (scripts/publish-product.mjs)
# Use an admin account. Never commit the real password.
PAYLOAD_SERVER_URL=https://example.com
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=replace-with-the-admin-password
