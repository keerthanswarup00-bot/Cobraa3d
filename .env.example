# Local development uses SQLite. For production, use a Neon or Supabase Postgres URL.
DATABASE_URL=file:./cobraa3d.db

# Generate a long random secret before deployment.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public origin used for canonical URLs and preview links. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload live preview and scheduled publishing.
PREVIEW_SECRET=replace-with-a-second-random-secret
CRON_SECRET=replace-with-a-third-random-secret

# Optional S3-compatible media storage (Cloudflare R2, AWS S3, or another provider).
# Leave blank for local public/media storage.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
