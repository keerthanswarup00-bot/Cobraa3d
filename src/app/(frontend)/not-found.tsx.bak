import Link from 'next/link'

export default function NotFound() {
  return (
    <main style={{ padding: '2rem', maxWidth: 640, margin: '0 auto', textAlign: 'center' }}>
      <h1 style={{ fontSize: 28, marginBottom: 12 }}>Page not found</h1>
      <p style={{ marginBottom: 24 }}>This page didn&apos;t print right.</p>
      <div style={{ display: 'flex', gap: 12, justifyContent: 'center', flexWrap: 'wrap' }}>
        <Link href="/" style={{ padding: '10px 16px', borderRadius: 6, border: '1px solid #ccc', textDecoration: 'none' }}>Go home</Link>
        <Link href="/products" style={{ padding: '10px 16px', borderRadius: 6, border: '1px solid #ccc', textDecoration: 'none' }}>View products</Link>
      </div>
